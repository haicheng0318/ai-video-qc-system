{
  "name": "@ai-video-qc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/tests/*.spec.ts",
    "test:http:result-review": "npm run build && node dist/scripts/result-review-http-acceptance.js",
    "test:http:rule-engine": "npm run build && node dist/scripts/rule-engine-http-acceptance.js",
    "test:http:final-evaluation": "npm run build && node dist/scripts/final-evaluation-http-acceptance.js",
    "test:http:phase-8": "npm run build && node dist/scripts/phase-8-http-acceptance.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-video-qc/shared": "*",
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cos-nodejs-sdk-v5": "3.0.0",
    "dotenv": "^16.4.7",
    "https-proxy-agent": "^7.0.6",
    "multer": "^2.3.0",
    "node-fetch": "^2.7.0",
    "openai": "^7.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node-fetch": "^2.6.13",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.7.2"
  }
}
