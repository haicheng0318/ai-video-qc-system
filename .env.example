DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME?schema=public"
JWT_SECRET=""
JWT_EXPIRES_IN="2h"
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="change-me-before-seeding"
DEFAULT_ADMIN_NAME="系统管理员"
MAX_VIDEO_SIZE_MB="500"
VIDEO_STORAGE_DIR="./storage/videos"
API_PORT="3001"
API_HOST="127.0.0.1"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_VIDEO_UPLOAD_MODE="multipart"
WEB_ORIGIN="http://localhost:3000"

# Permanent video storage. Use "local" for development and "cos" in CloudBase production.
VIDEO_STORAGE_PROVIDER="local"
VIDEO_UPLOAD_TEMP_DIR=""
COS_REGION=""
COS_BUCKET=""
COS_VIDEO_PREFIX="ai-video-qc/videos"
COS_SIGNED_URL_TTL_SECONDS="900"
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENTCLOUD_SESSION_TOKEN=""

# AI credentials are backend-only. Keep real values in the ignored local .env file.
DASHSCOPE_API_KEY=""
QWEN_MODEL="qwen3.5-omni-plus"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_REQUEST_TIMEOUT_MS="300000"
QWEN_RUNNING_STALE_MINUTES="15"
OSS_REGION="oss-cn-beijing"
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_REQUEST_TIMEOUT_MS="300000"
OSS_SIGNED_URL_TTL_SECONDS="3600"
OSS_TEMP_PREFIX="ai-video-qc/content-review"
OSS_ENDPOINT=""
QWEN_TEXT_REQUEST_TIMEOUT_MS="120000"
QWEN_RESULT_REVIEW_MODEL="qwen3.5-plus"
QWEN_RESULT_REVIEW_MAX_OUTPUT_TOKENS="4000"
QWEN_RESULT_REVIEW_RUNNING_STALE_MINUTES="10"
QWEN_FINAL_EVALUATION_MODEL="qwen3.5-plus"
QWEN_FINAL_EVALUATION_MAX_OUTPUT_TOKENS="4000"
QWEN_FINAL_EVALUATION_RUNNING_STALE_MINUTES="10"
# Durable evaluation worker lease (15–600 seconds); initial database-global concurrency is 1.
EVALUATION_JOB_LEASE_MS=90000

# Required by docker-compose.yml at runtime. Keep real values in local untracked configuration.
POSTGRES_PASSWORD=""
